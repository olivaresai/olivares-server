# CTR-25: the command writes its answer and errors to the container's terminal devices
allow olivares_cmd_t container_file_t:chr_file { ioctl open read write };

# CTR-26: the command exchanges stdin, stdout and stderr with the container runtime
allow olivares_cmd_t container_runtime_t:fifo_file { read write };

# CTR-29: Claude watches /etc/claude-code, the only etc_t directory the launch mounts
allow olivares_tool_t etc_t:dir watch;

# CTR-30: Claude watches settings.json in its own account home
allow olivares_tool_t olivares_tool_home_t:file watch;

# CTR-31: uname, id and the shell read procfs in the container
allow olivares_cmd_t proc_t:file { getattr open read };

# CTR-32: Claude creates and removes its local messaging socket in the container
allow olivares_tool_t container_file_t:sock_file { create setattr unlink };

# CTR-33: Claude watches managed-settings.json in the only etc_t directory the launch mounts
