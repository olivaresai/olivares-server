# HOOK-08: its own client socket to the PEP (connect create getattr getopt setopt measured on candidate rc16); read and write carry the request and the decision
allow olivares_hook_t self:tcp_socket { connect create getattr getopt read setopt write };

# HOOK-09: the PEP listens on a loopback port the kernel chose (claudehookpep.go defaultHookPEPListen 127.0.0.1:0), measured on candidate rc16. shortcut: a compromised olivares binary in olivares_hook_t could reach remote ephemeral ports (SELinux name_connect checks only the port label); the rule that holds it: in olivares_hook_t the program runs only as claude-hook (any other command is refused before it runs), and claude-hook refuses a PEP endpoint off loopback before it dials; an unreadable context denies every other command, and the client follows no redirect or environment proxy (cmd/olivares/claudehook_domain.go); upgrade when the PEP moves to a unix socket
allow olivares_hook_t ephemeral_port_t:tcp_socket name_connect;

