########################################
#
# Rules, one per row
#

# ---- PORTAL ----

# PORTAL-05: stdin/stdout/stderr (journal stream, passed socket or tty) are descriptors PID 1 opened; explicit so it holds with the policy boolean domain_fd_use off
allow olivares_portal_t init_t:fd use;

# ---- RCON ----

# RCON-05: stdin/stdout/stderr (journal stream, passed socket or tty) are descriptors PID 1 opened; explicit so it holds with the policy boolean domain_fd_use off
allow olivares_repair_console_t init_t:fd use;

# ---- HPWR ----

# HPWR-05: stdin/stdout/stderr (journal stream, passed socket or tty) are descriptors PID 1 opened; explicit so it holds with the policy boolean domain_fd_use off
allow olivares_helper_power_t init_t:fd use;

# ---- HBND ----

# HBND-05: stdin/stdout/stderr (journal stream, passed socket or tty) are descriptors PID 1 opened; explicit so it holds with the policy boolean domain_fd_use off
allow olivares_helper_bundle_t init_t:fd use;

# ---- SNAP ----

# SNAP-05: stdin/stdout/stderr (journal stream, passed socket or tty) are descriptors PID 1 opened; explicit so it holds with the policy boolean domain_fd_use off
allow olivares_snapshotcore_t init_t:fd use;

# ---- FBOOT ----

# FBOOT-05: stdin/stdout/stderr (journal stream, passed socket or tty) are descriptors PID 1 opened; explicit so it holds with the policy boolean domain_fd_use off
allow olivares_firstboot_t init_t:fd use;

# ---- PROD ----

# PROD-05: stdin/stdout/stderr (journal stream, passed socket or tty) are descriptors PID 1 opened; explicit so it holds with the policy boolean domain_fd_use off
allow olivares_t init_t:fd use;

# ---- PORTAL ----

# PORTAL-10: systemd labels a socket unit's listener with its service's domain (socket.c:1480-1500, service.c:5720); tcp 9443 alone is olivares_portal_port_t (semanage port -a; the base policy's pki_ca_port_t covers 9443-9447, corenetwork.te.in)
allow olivares_portal_t olivares_portal_port_t:tcp_socket name_bind;

# PORTAL-11: the bind to 127.0.0.1 is checked on the socket's domain; lo_node_t is an alias of node_t (corenetwork.te.in)
allow olivares_portal_t node_t:tcp_socket node_bind;

# PORTAL-12: serves TLS on the passed listener; reads SO_BINDTODEVICE back (getopt); Go sets TCP options on accepted connections (setopt)
allow olivares_portal_t self:tcp_socket { accept getattr getopt read setopt shutdown write };

# PORTAL-47: creates the authenticated engine client's TCP socket; existing listener permissions also hold its I/O
allow olivares_portal_t self:tcp_socket { connect create };

# PORTAL-48: the authenticated engine client reaches tcp 8443 only, labeled olivares_console_port_t; the unit permits loopback only
allow olivares_portal_t olivares_console_port_t:tcp_socket name_connect;

# PORTAL-13: reaches /etc/olivares-portal
allow olivares_portal_t etc_t:dir search;

# PORTAL-14: custody check of the operator's TLS directory by lstat
allow olivares_portal_t olivares_portal_etc_t:dir { getattr search };

# PORTAL-15: reads the published selection; lstat of tls.crt
allow olivares_portal_t olivares_portal_etc_t:file { getattr open read };

# PORTAL-16: custody of tls.key is measured by lstat only; the key reaches the console as a credential, never by open
allow olivares_portal_t olivares_portal_key_t:file getattr;

# PORTAL-17: PID 1 reads the certificate for LoadCredential=
allow init_t olivares_portal_etc_t:file { getattr open read };

# PORTAL-18: PID 1 reads the console's key for LoadCredential=; first boot's own access is FBOOT-103
allow init_t olivares_portal_key_t:file { getattr open read };

# PORTAL-19: reaches /run/credentials/olivares-portal.service
allow olivares_portal_t var_run_t:dir search;

# PORTAL-20: the unit's credential directory, labeled by file context when systemd sets it up (exec-credential.c:974,1051)
allow olivares_portal_t olivares_portal_cred_t:dir { getattr open read search };

# PORTAL-21: reads the delivered tls.crt and tls.key copies
allow olivares_portal_t olivares_portal_cred_t:file { getattr open read };

# PORTAL-22: reaches the firewall owner's measurement
allow olivares_portal_t olivares_firewall_run_t:dir search;

# PORTAL-23: reads the firewall measurement of this boot
allow olivares_portal_t olivares_firewall_run_t:file { getattr open read };

# PORTAL-24: reaches /proc/sys
allow olivares_portal_t proc_t:dir search;

# PORTAL-25: reaches /proc/sys/kernel
allow olivares_portal_t sysctl_t:dir search;

# PORTAL-26: reads this boot's id
allow olivares_portal_t sysctl_kernel_t:file { getattr open read };

# PORTAL-27: PID 1 mounts the credential file system on the unit's credential directory (exec-credential.c:1040-1051)
allow init_t olivares_portal_cred_t:dir mounton;

# PORTAL-28: the inherited local listener and the connections it accepts, which carry its label: accept, the socket addresses, SO_PASSCRED, SO_PEERCRED and SO_PEERPIDFD, the TIOCINQ unread-byte ioctl (no allowxperm names this domain, so the ioctl permission is the whole check), recvmsg and write; no listen or bind
allow olivares_portal_t self:unix_stream_socket { accept getattr getopt ioctl read write };

# PORTAL-29: reaches its own /proc/self/fdinfo
allow olivares_portal_t self:dir search;

# PORTAL-30: reads the held pidfd's fdinfo (its Pid: line); the path is its own, never chosen by the caller
allow olivares_portal_t self:file { getattr open read };

# PORTAL-31: reaches /proc/<peer> of the one admitted caller domain; a peer in any other domain cannot be read and is refused
allow olivares_portal_t olivares_cli_t:dir search;

# PORTAL-32: reads the peer's cgroup after holding its pidfd, and again before each request; no /proc/<peer>/fd
allow olivares_portal_t olivares_cli_t:file { getattr open read };

# PORTAL-33: olivares-admins membership of a non-root peer from /etc/group and /etc/passwd (authlogin.fc; PORTAL-13 reaches /etc)
allow olivares_portal_t passwd_file_t:file { getattr open read };

# PORTAL-34: reaches lifecycle.lock; no add_name, remove_name or write in the directory
allow olivares_portal_t olivares_lifecycle_run_t:dir search;

# PORTAL-35: a read-only open and flock(LOCK_SH|LOCK_NB); the lock permission does not tell shared from exclusive, and the portal's role refuses exclusive in the source; no write, unlink or replacement of the inode
allow olivares_portal_t olivares_lifecycle_lock_t:file { getattr lock open read };

# PORTAL-36: reaches /var/lib/olivares-portal (files.fc)
allow olivares_portal_t var_lib_t:dir search;

# PORTAL-37: the root-owned parent of the leaf: search only, so the leaf's stat succeeds and nothing is created beside it
allow olivares_portal_t olivares_portal_var_lib_t:dir search;

# PORTAL-38: the operations leaf: create its private audit subdirectory, stat, create store.lock and records, list the records, remove a record whose write failed, rename a rewritten record into place and fsync the directory (fsync has no SELinux permission)
allow olivares_portal_t olivares_portal_ops_t:dir { add_name create getattr open read remove_name search write };

# PORTAL-39: store.lock (created once, flock exclusive), hostop/v1 records and the audit spool: create, read, write, append (O_APPEND), fsync, rename over a record (unlink of the replaced inode); records and lock only, never an authority store
allow olivares_portal_t olivares_portal_ops_t:file { append create getattr lock open read rename unlink write };

# ---- RCON ----

# RCON-10: the console's standard input and output are /dev/tty1, opened by PID 1
allow olivares_repair_console_t tty_device_t:chr_file { getattr ioctl read write };

# RCON-11: reaches /run/olivares-helpers
allow olivares_repair_console_t var_run_t:dir search;

# RCON-12: reaches the helpers' socket directory
allow olivares_repair_console_t olivares_helper_run_t:dir search;

# RCON-13: lstat of the power socket, then connect
allow olivares_repair_console_t olivares_helper_power_sock_t:sock_file { getattr write };

# RCON-14: the listening socket carries the power helper's domain (socket.c:1431-1500 loads the template's internal instance)
allow olivares_repair_console_t olivares_helper_power_t:unix_stream_socket connectto;

# RCON-15: its own client socket: write the document, half-close, read the answer
allow olivares_repair_console_t self:unix_stream_socket { connect create getattr read shutdown write };

# ---- HPWR ----

# HPWR-10: PID 1 creates /run/olivares-helpers with its file-context label (mkdir_parents_label); RemoveOnStop= on pam.sock removes it from the directory
allow init_t olivares_helper_run_t:dir { add_name create getattr remove_name search setattr write };

# HPWR-11: PID 1 binds the socket file with its file-context label, sets owner and mode and writes it as its binder
allow init_t olivares_helper_power_sock_t:sock_file { create getattr setattr unlink write };

# HPWR-12: the accepted connection inherits the listener's label; SO_PEERCRED and SO_PEERPIDFD are getopt
allow olivares_helper_power_t self:unix_stream_socket { getattr getopt read shutdown write };

# HPWR-13: reaches /proc
allow olivares_helper_power_t proc_t:dir search;

# HPWR-14: reads the pidfd's fdinfo in its own /proc
allow olivares_helper_power_t self:file { getattr open read };

# HPWR-15: attests the one admitted invoker, the repair console; other peers stay unattested and are refused
allow olivares_helper_power_t olivares_repair_console_t:dir search;

# HPWR-16: reads the invoker's cgroup and status line
allow olivares_helper_power_t olivares_repair_console_t:file { getattr open read };

# HPWR-17: liveness by pidfd_send_signal with signal 0
allow olivares_helper_power_t olivares_repair_console_t:process signull;

# HPWR-18: reaches /etc/passwd
allow olivares_helper_power_t etc_t:dir search;

# HPWR-19: names the peer's account (root)
allow olivares_helper_power_t passwd_file_t:file { getattr open read };

# HPWR-20: runs systemctl in its own domain, no shell (systemd.fc labels /usr/bin/systemctl)
allow olivares_helper_power_t systemd_systemctl_exec_t:file { execute execute_no_trans getattr map open read };

# HPWR-21: systemctl's own bus connection
allow olivares_helper_power_t self:unix_stream_socket { connect create };

# HPWR-22: systemctl 259 asks logind first (systemctl-start-special.c:201-214)
allow olivares_helper_power_t system_dbusd_var_run_t:dir search;

# HPWR-23: connects to the system bus
allow olivares_helper_power_t system_dbusd_var_run_t:sock_file write;

# HPWR-24: connects to the system bus
allow olivares_helper_power_t system_dbusd_t:unix_stream_socket connectto;

# HPWR-25: bus Hello and name lookups
allow olivares_helper_power_t system_dbusd_t:dbus send_msg;

# HPWR-26: the bus answers
allow system_dbusd_t olivares_helper_power_t:dbus send_msg;

# HPWR-27: Reboot/PowerOff method calls to logind (systemd_dbus_chat_logind, systemd.if)
allow olivares_helper_power_t systemd_logind_t:dbus send_msg;

# HPWR-28: logind's replies
allow systemd_logind_t olivares_helper_power_t:dbus send_msg;

# HPWR-29: systemctl falls back to PID 1's private socket when logind is absent (systemctl-start-special.c:209-214)
allow olivares_helper_power_t init_var_run_t:dir search;

# HPWR-30: the fallback connection
allow olivares_helper_power_t init_var_run_t:sock_file write;

# HPWR-31: the fallback connection
allow olivares_helper_power_t init_t:unix_stream_socket connectto;

# HPWR-32: the fallback starts reboot.target or poweroff.target (systemd.fc label power_unit_file_t)
allow olivares_helper_power_t power_unit_file_t:service start;

# HPWR-33: systemctl stats /proc/1/root to detect a chroot; the kernel's ptrace read check is file read on PID 1's domain (systemd_systemctl_common: init_read_state)
allow olivares_helper_power_t init_t:dir search;

# HPWR-34: systemctl stats /proc/1/root to detect a chroot; the kernel's ptrace read check is file read on PID 1's domain (systemd_systemctl_common: init_read_state)
allow olivares_helper_power_t init_t:lnk_file { getattr read };

# HPWR-35: systemctl stats /proc/1/root to detect a chroot; the kernel's ptrace read check is file read on PID 1's domain (systemd_systemctl_common: init_read_state)
allow olivares_helper_power_t init_t:file read;

# HPWR-36: reaches /run/dbus and /run/systemd
allow olivares_helper_power_t var_run_t:dir search;

# ---- HBND ----

# HBND-10: PID 1 binds the socket file with its file-context label and touches it after listen (socket_address_listen)
allow init_t olivares_helper_bundle_sock_t:sock_file { create getattr setattr unlink write };

# HBND-11: its connection; no invoker is admitted, so no peer /proc or passwd read is granted
allow olivares_helper_bundle_t self:unix_stream_socket { getattr getopt read shutdown write };

# HBND-12: reaches its state directory
allow olivares_helper_bundle_t var_lib_t:dir search;

# HBND-13: creates acts/ and out/, syncs the directory after a create
allow olivares_helper_bundle_t olivares_helper_bundle_var_lib_t:dir { add_name create getattr open read search write };

# HBND-14: creates the key and bundles once, never replaces; reads its own files
allow olivares_helper_bundle_t olivares_helper_bundle_var_lib_t:file { create getattr open read write };

# HBND-15: PID 1 creates and chowns the state directory and bind-mounts it writable under ProtectSystem=strict
allow init_t olivares_helper_bundle_var_lib_t:dir { create getattr mounton setattr };

# HBND-16: /etc/os-release is a link to /usr/lib/os-release (lib_t, read by every domain in the base policy, domain.te)
allow olivares_helper_bundle_t etc_t:lnk_file { getattr read };

# HBND-17: reaches /proc/sys
allow olivares_helper_bundle_t proc_t:dir search;

# HBND-18: reaches /proc/sys/kernel
allow olivares_helper_bundle_t sysctl_t:dir search;

# HBND-19: kernel release and boot id
allow olivares_helper_bundle_t sysctl_kernel_t:file { getattr open read };

# ---- SNAP ----

# SNAP-10: reaches /boot
allow olivares_snapshotcore_t boot_t:dir { getattr search };

# SNAP-11: creates /boot/olivares on first use
allow olivares_snapshotcore_t boot_t:dir { add_name write };

# SNAP-12: a /boot/olivares created at run time is labeled olivares_boot_t, not boot_t
type_transition olivares_snapshotcore_t boot_t:dir olivares_boot_t "olivares";

# SNAP-13: journal/ and store/ directories; SyncDir and ReadDir open the directory
allow olivares_snapshotcore_t olivares_boot_t:dir { add_name create getattr open read remove_name search write };

# SNAP-14: manifest, entries, journal and store files: temp, link, rename, remove; flock of the operation lock
allow olivares_snapshotcore_t olivares_boot_t:file { create getattr link lock open read rename unlink write };

# SNAP-15: reaches /run
allow olivares_snapshotcore_t var_run_t:dir search;

# SNAP-16: boot.json and witness.json
allow olivares_snapshotcore_t olivares_snapshotcore_run_t:dir { add_name getattr open read remove_name search write };

# SNAP-17: boot.json published by link without replacing; witness.json by rename
allow olivares_snapshotcore_t olivares_snapshotcore_run_t:file { create getattr link open read rename unlink write };

# SNAP-18: PID 1 creates the runtime directory with its file-context label
allow init_t olivares_snapshotcore_run_t:dir { create getattr setattr };

# SNAP-19: custody check of /run/olivares-boot by an opened descriptor
allow olivares_snapshotcore_t olivares_boot_run_t:dir { getattr open read search };

# SNAP-20: reads the initrd's booted-root record
allow olivares_snapshotcore_t olivares_boot_run_t:file { getattr open read };

# SNAP-21: reaches /proc
allow olivares_snapshotcore_t proc_t:dir search;

# SNAP-22: the kernel command line names the booted entry
allow olivares_snapshotcore_t proc_t:file { getattr open read };

# SNAP-23: reaches /proc/sys/kernel
allow olivares_snapshotcore_t sysctl_t:dir search;

# SNAP-24: boot id and kernel release
allow olivares_snapshotcore_t sysctl_kernel_t:file { getattr open read };

# SNAP-25: its own /proc entries and those of other snapshotcore processes
allow olivares_snapshotcore_t self:dir search;

# SNAP-26: mount table; start time of a journal owner that is a snapshotcore process
allow olivares_snapshotcore_t self:file { getattr open read };

# SNAP-27: BTRFS_IOC_GET_SUBVOL_INFO on the mounted root, no privilege
allow olivares_snapshotcore_t root_t:dir { getattr ioctl open read search };

# SNAP-28: reaches /var/lib
allow olivares_snapshotcore_t var_lib_t:dir search;

# SNAP-29: subvolume id and UUID of the product's data volume; no file inside is opened
allow olivares_snapshotcore_t olivares_var_lib_t:dir { getattr ioctl open read search };

# SNAP-30: subvolume id and UUID of the first-boot volume; no file inside is opened
allow olivares_snapshotcore_t olivares_appliance_var_lib_t:dir { getattr ioctl open read search };

# SNAP-31: the boot filesystem's UUID
allow olivares_snapshotcore_t device_t:dir { getattr open read search };

# SNAP-32: resolves each by-uuid link
allow olivares_snapshotcore_t device_t:lnk_file { getattr read };

# SNAP-33: lstat of the device node; never opened
allow olivares_snapshotcore_t fixed_disk_device_t:blk_file getattr;

# SNAP-34: /lib is a link to usr/lib
allow olivares_snapshotcore_t lib_t:lnk_file { getattr read };

# SNAP-35: walks the module tree (files.fc labels /usr/lib/modules)
allow olivares_snapshotcore_t modules_object_t:dir { getattr open read search };

# SNAP-36: digests module files
allow olivares_snapshotcore_t modules_object_t:file { getattr open read };

# SNAP-37: digests the tree's links
allow olivares_snapshotcore_t modules_object_t:lnk_file { getattr read };

# SNAP-38: hashes the distribution's kernel and initrd a boot without a return-point entry booted
allow olivares_snapshotcore_t boot_t:file { getattr open read };

# ---- FBOOT ----

# FBOOT-10: reads authorized keys; stages the setup-token hash in the product-owned directory and chowns only its dedicated type
allow olivares_firstboot_t self:capability { chown dac_override dac_read_search };

# FBOOT-11: reaches /var/lib
allow olivares_firstboot_t var_lib_t:dir search;

# FBOOT-12: atomic replace of state.json and ready; directory sync
allow olivares_firstboot_t olivares_appliance_var_lib_t:dir { add_name getattr open read remove_name search write };

# FBOOT-13: state record, ready marker and the run lock
allow olivares_firstboot_t olivares_appliance_var_lib_t:file { create getattr lock open read rename setattr unlink write };

# FBOOT-14: PID 1 sets owner and mode of the state directory and bind-mounts it writable under ProtectSystem=strict
allow init_t olivares_appliance_var_lib_t:dir { getattr mounton setattr };

# FBOOT-15: reaches /run/credentials
allow olivares_firstboot_t var_run_t:dir search;

# FBOOT-16: the answers credential directory
allow olivares_firstboot_t olivares_firstboot_cred_t:dir { getattr open read search };

# FBOOT-17: the answers credential
allow olivares_firstboot_t olivares_firstboot_cred_t:file { getattr open read };

# FBOOT-18: reaches /etc; lists /etc/ssh for the host keys
allow olivares_firstboot_t etc_t:dir { getattr open read search };

# FBOOT-19: reaches the carriers
allow olivares_firstboot_t olivares_appliance_etc_t:dir { getattr search };

# FBOOT-20: reads the answers carriers, lstat first
allow olivares_firstboot_t olivares_appliance_etc_t:file { getattr open read };

# FBOOT-21: keyed digest of the machine id
allow olivares_firstboot_t machineid_t:file { getattr open read };

# FBOOT-22: reads the SSH host public keys only; the private keys keep the base policy's sshd_key_t (ssh.fc)
allow olivares_firstboot_t olivares_ssh_host_pub_t:file { getattr open read };

# FBOOT-23: reaches /proc
allow olivares_firstboot_t proc_t:dir search;

# FBOOT-24: reaches /proc/sys/kernel
allow olivares_firstboot_t sysctl_t:dir search;

# FBOOT-25: verifies the kernel host name
allow olivares_firstboot_t sysctl_kernel_t:file { getattr open read };

# FBOOT-26: verifies UTC (miscfiles.fc labels /etc/localtime)
allow olivares_firstboot_t locale_t:lnk_file { getattr read };

# FBOOT-27: lists /home
allow olivares_firstboot_t home_root_t:dir { getattr open read search };

# FBOOT-28: enters each home
allow olivares_firstboot_t user_home_dir_t:dir { getattr search };

# FBOOT-29: enters /root
allow olivares_firstboot_t admin_home_t:dir { getattr search };

# FBOOT-30: enters .ssh (ssh.fc)
allow olivares_firstboot_t ssh_home_t:dir { getattr search };

# FBOOT-31: reads authorized_keys
allow olivares_firstboot_t ssh_home_t:file { getattr open read };

# FBOOT-37: resolves the product account's uid from the passwd file, without executing a program
allow olivares_firstboot_t passwd_file_t:file { getattr open read };

# FBOOT-38: runs the product's generator in the first-boot domain, not the product's
allow olivares_firstboot_t olivares_exec_t:file { execute execute_no_trans getattr map open read };

# FBOOT-39: the generator writes olivares.env and its .bak
allow olivares_firstboot_t olivares_etc_t:dir { add_name getattr search write };

# FBOOT-40: writes, chmods and re-reads the product configuration
allow olivares_firstboot_t olivares_etc_t:file { create getattr open read setattr write };

# FBOOT-41: atomic write of 50-olivares-appliance.conf, including opening and syncing its directory
allow olivares_firstboot_t olivares_unit_file_t:dir { add_name getattr open read remove_name search write };

# FBOOT-42: the drop-in, written and verified
allow olivares_firstboot_t olivares_unit_file_t:file { create getattr open read rename setattr unlink write };

# FBOOT-43: publishes or withdraws the console's selection, including opening and syncing its directory
allow olivares_firstboot_t olivares_portal_etc_t:dir { add_name getattr open read remove_name search write };

# FBOOT-44: selection.json temporary is O_RDWR and the published selection is verified; tls.key has its own type
allow olivares_firstboot_t olivares_portal_etc_t:file { create getattr open read rename setattr unlink write };

# FBOOT-45: runs systemctl in its own domain
allow olivares_firstboot_t systemd_systemctl_exec_t:file { execute execute_no_trans getattr map open read };

# FBOOT-46: systemctl's connection
allow olivares_firstboot_t self:unix_stream_socket { connect create getattr read write };

# FBOOT-47: systemctl as uid 0 uses /run/systemd/private
allow olivares_firstboot_t init_var_run_t:dir search;

# FBOOT-48: connects to PID 1
allow olivares_firstboot_t init_var_run_t:sock_file write;

# FBOOT-49: connects to PID 1
allow olivares_firstboot_t init_t:unix_stream_socket connectto;

# FBOOT-50: Reload checks the manager's reload permission, GetUnitFileState its status permission (dbus-manager.c:1561-1567, 2231-2241)
allow olivares_firstboot_t init_t:system { reload status };

# FBOOT-51: enables, starts and reads olivares.service only
allow olivares_firstboot_t olivares_unit_file_t:service { enable start status };

# FBOOT-52: checks the data directory; stages and renames the setup-token hash, with no write permission on existing private files
allow olivares_firstboot_t olivares_var_lib_t:dir { add_name getattr remove_name search write };

# FBOOT-53: pins readiness to the instance certificate; lstat of the identity files and the store
allow olivares_firstboot_t olivares_var_lib_t:file { getattr open read };

# FBOOT-54: polls the product's /readyz over TLS
allow olivares_firstboot_t self:tcp_socket { connect create getattr getopt read setopt shutdown write };

# FBOOT-55: tcp 8443 is olivares_console_port_t (semanage port -m)
allow olivares_firstboot_t olivares_console_port_t:tcp_socket name_connect;

# FBOOT-56: systemctl stats /proc/1/root to detect a chroot; the kernel's ptrace read check is file read on PID 1's domain (systemd_systemctl_common: init_read_state)
allow olivares_firstboot_t init_t:dir search;

# FBOOT-57: systemctl stats /proc/1/root to detect a chroot; the kernel's ptrace read check is file read on PID 1's domain (systemd_systemctl_common: init_read_state)
allow olivares_firstboot_t init_t:lnk_file { getattr read };

# FBOOT-58: systemctl stats /proc/1/root to detect a chroot; the kernel's ptrace read check is file read on PID 1's domain (systemd_systemctl_common: init_read_state)
allow olivares_firstboot_t init_t:file read;

# FBOOT-59: a directory cloud-init's write_files creates in /etc gets the carriers' type even if the package did not ship it
type_transition cloud_init_t etc_t:dir olivares_appliance_etc_t "olivares-appliance";

# FBOOT-60: PID 1 bind-mounts each ReadWritePaths= directory writable under ProtectSystem=strict
allow init_t olivares_etc_t:dir mounton;

# FBOOT-61: PID 1 bind-mounts each ReadWritePaths= directory writable under ProtectSystem=strict
allow init_t olivares_unit_file_t:dir mounton;

# FBOOT-62: PID 1 bind-mounts each ReadWritePaths= directory writable under ProtectSystem=strict
allow init_t olivares_portal_etc_t:dir mounton;

# FBOOT-63: PID 1 mounts the credential file system on the unit's credential directory and removes the directory when the unit stops
allow init_t olivares_firstboot_cred_t:dir { mounton rmdir };

# FBOOT-64: stats /usr/bin/cloud-init (cloud_init_exec_t, cloudform.fc) to learn that cloud-init is installed; never executes it
allow olivares_firstboot_t cloud_init_exec_t:file getattr;

# FBOOT-65: reaches /run/cloud-init, which the base policy labels net_conf_t (sysnetwork.fc)
allow olivares_firstboot_t net_conf_t:dir search;

# FBOOT-66: follows status.json and result.json in /run/cloud-init, which cloud-init writes as links into /var/lib/cloud/data
allow olivares_firstboot_t net_conf_t:lnk_file { getattr read };

# FBOOT-67: reaches the link targets in /var/lib/cloud/data (cloud_var_lib_t, cloudform.fc)
allow olivares_firstboot_t cloud_var_lib_t:dir search;

# FBOOT-68: reads status.json and stats result.json, cloud-init's record of its stages
allow olivares_firstboot_t cloud_var_lib_t:file { getattr open read };

# FBOOT-69: reads /etc/userdb/<account>.user when the passwd file lacks the account, and stats /etc/cloud/cloud-init.disabled (etc_t, files.fc)
allow olivares_firstboot_t etc_t:file { getattr open read };

# FBOOT-70: stats /run/cloud-init/disabled, the marker cloud-init's generator writes when it disables cloud-init
allow olivares_firstboot_t net_conf_t:file getattr;

# FBOOT-71: reads /proc/cmdline for cloud-init=enabled or cloud-init=disabled
allow olivares_firstboot_t proc_t:file { getattr open read };

# FBOOT-72: reads /run/userdb and /run/host/userdb records, which carry no label of their own (var_run_t, files.fc)
allow olivares_firstboot_t var_run_t:file { getattr open read };

# FBOOT-73: reads /usr/lib/userdb records (lib_t, libraries.fc), as the base policy's domain baseline also allows
allow olivares_firstboot_t lib_t:file { getattr open read };

# ---- PROD ----

# PROD-10: reaches /var/lib
allow olivares_t var_lib_t:dir search;

# PROD-11: the product owns its data volume
allow olivares_t olivares_var_lib_t:dir { add_name create getattr open read remove_name rename reparent rmdir search setattr write };

# PROD-12: keys, TLS material and the SQLite store (locks, journal files, shared-memory map)
allow olivares_t olivares_var_lib_t:file { append create getattr link lock map open read rename setattr unlink write };

# PROD-13: binds and serves its two listeners itself
allow olivares_t self:tcp_socket { accept bind create getattr getopt listen read setopt shutdown write };

# PROD-14: tcp 8443 alone is olivares_console_port_t (semanage port -m; the base policy's http_port_t also holds 80, 443, 8008, 8009 and 9000, corenetwork.te.in)
allow olivares_t olivares_console_port_t:tcp_socket name_bind;

# PROD-15: tcp 8444 is unreserved_port_t only by the base policy's 1024-32767 range (corenetwork.te.in); the module gives it olivares_grpc_port_t alone (semanage port -a)
allow olivares_t olivares_grpc_port_t:tcp_socket name_bind;

# PROD-16: the wildcard address (inaddr_any_node_t is an alias of node_t)
allow olivares_t node_t:tcp_socket node_bind;

# PROD-36: PID 1 sets owner and mode of the data directory and bind-mounts it (and workspaces/) writable
allow init_t olivares_var_lib_t:dir { getattr mounton setattr };

# PROD-17: PID 1 reads the environment file
allow init_t olivares_etc_t:file { getattr open read };

# PROD-18: PID 1 reads the product's drop-in directory
allow init_t olivares_unit_file_t:dir { getattr open read search };

# PROD-19: PID 1 reads olivares.service and its drop-ins
allow init_t olivares_unit_file_t:file { getattr open read };

# PROD-21: the conducted runtime JIT-compiles; granted only while the boolean is on
tunable_policy(`olivares_operate_runtime',`
	allow olivares_t self:process execmem;
')

# PROD-22: outbound HTTPS to model providers
allow olivares_t self:tcp_socket connect;

# PROD-23: tcp 443 is http_port_t (corenetwork.te.in)
allow olivares_t http_port_t:tcp_socket name_connect;

# PROD-24: resolves the provider's host name (DNS over UDP)
allow olivares_t self:udp_socket { connect create getattr getopt read setopt write };

# PROD-25: DNS over TCP for long answers (corenetwork.te.in)
allow olivares_t dns_port_t:tcp_socket name_connect;

# PROD-26: resolv.conf, hosts, nsswitch.conf (sysnetwork.fc)
allow olivares_t net_conf_t:file { getattr open read };

# PROD-27: /etc/resolv.conf is a link into /run/NetworkManager when NetworkManager makes it (a link into /run/systemd/resolve where systemd-resolved is installed)
allow olivares_t net_conf_t:lnk_file { getattr read };

# PROD-28: reaches /run/systemd/resolve
allow olivares_t init_var_run_t:dir search;

# PROD-29: reaches stub-resolv.conf (systemd.fc)
allow olivares_t systemd_resolved_var_run_t:dir search;

# PROD-30: reads stub-resolv.conf
allow olivares_t systemd_resolved_var_run_t:file { getattr open read };

