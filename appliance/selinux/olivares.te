# CTR-18: and creates and removes temporary symbolic links
allow olivares_cmd_t container_file_t:lnk_file { create link rename setattr unlink };

# CTR-19: runc/dockerd sends SIGTERM and SIGKILL to the session container's PID 1 on docker stop and forced cleanup, as TOOL-95 for a native session
