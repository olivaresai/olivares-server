allow olivares_container_relay_t olivares_tool_exec_t:file { execute getattr map open read };

# RELAY-07: the relay's containerExecArg stage enters the tool without a same-domain re-exec
type_transition olivares_container_relay_t olivares_tool_exec_t:process olivares_tool_t;

# RELAY-08: the relay-to-tool transition is allowed
allow olivares_container_relay_t olivares_tool_t:process transition;

# RELAY-09: the tool keeps no_new_privileges
allow olivares_container_relay_t olivares_tool_t:process2 { nnp_transition nosuid_transition };

# RELAY-10: only the relay reaches the readiness and egress socket directory
allow olivares_container_relay_t olivares_engine_tmp_t:dir search;

# RELAY-11: only the relay connects to the readiness and proxy sockets
allow olivares_container_relay_t olivares_engine_tmp_t:sock_file write;

# RELAY-12: only the relay connects to the engine's Unix listeners
allow olivares_container_relay_t olivares_t:unix_stream_socket connectto;

# RELAY-14: the relay's Go runtime traverses its cgroup directory before main
allow olivares_container_relay_t cgroup_t:dir search;

# RELAY-15: the relay's Go runtime reads only the huge page size before main
allow olivares_container_relay_t sysfs_t:file { open read };

# RELAY-19: the relay reads runc's stdin and writes its stdout and stderr
allow olivares_container_relay_t container_runtime_t:fifo_file { read write };

# RELAY-20: the relay traverses the session image to look up the tool
allow olivares_container_relay_t container_file_t:dir search;

# RELAY-21: the relay's Go runtime opens and reads its CPU limit
allow olivares_container_relay_t cgroup_t:file { open read };

# RELAY-22: the relay follows only the image's localtime link
allow olivares_container_relay_t container_file_t:lnk_file read;

# RELAY-23: the relay handles terminal flags on its stdio pipes
allow olivares_container_relay_t container_runtime_t:fifo_file ioctl;

# RELAY-24: the relay reads the image's machine-id and the installed tool's ELF interpreter
allow olivares_container_relay_t container_file_t:file { read open getattr };

# RELAY-26: the relay creates, binds, listens on and accepts its loopback sockets
allow olivares_container_relay_t self:tcp_socket { create setopt bind listen getattr accept };

# RELAY-27: loopback-only binding comes from the network namespace and serveNamespace, not from node_t
allow olivares_container_relay_t node_t:tcp_socket node_bind;

# RELAY-28: the relay traverses only procfs net sysctls
allow olivares_container_relay_t sysctl_net_t:dir search;

# RELAY-29: the relay reads only the listen backlog limit
allow olivares_container_relay_t sysctl_net_t:file { read open };

# RELAY-30: the relay listens on the provider's measured loopback local-model port
allow olivares_container_relay_t olivares_model_runtime_port_t:tcp_socket name_bind;

# RELAY-31: the relay clears permitted, effective and inheritable capability sets before the tool; the container's bounding set is already empty
allow olivares_container_relay_t self:process setcap;

# RELAY-32: the relay executes only the installed tool's ELF interpreter, never an image entrypoint or transition
allow olivares_container_relay_t container_file_t:file execute;

# RELAY-33: the relay reads the requests it accepts on its loopback listeners and writes their answers back
allow olivares_container_relay_t self:tcp_socket { read write };

# RELAY-34: the relay executes Claude Code only into olivares_tool_t
allow olivares_container_relay_t olivares_tool_claude_exec_t:file { execute getattr map open read };

# RELAY-35: the relay's containerExecArg stage enters the tool through Claude Code's dedicated executable type
type_transition olivares_container_relay_t olivares_tool_claude_exec_t:process olivares_tool_t;

# ---- HSTA ----

# HSTA-01: ownership and mode of the verified backup filesystem root only
allow olivares_helper_storage_t self:capability { chown fowner };

# HSTA-02: queue and observe only the fixed native growth unit
allow olivares_helper_storage_t init_t:dbus send_msg;

# HSTA-03: authenticated native growth job result
allow init_t olivares_helper_storage_t:dbus send_msg;

# HSTA-04: only the fixed native maintenance template can be started
allow olivares_helper_storage_t olivares_storage_grow_unit_file_t:service { start status };

# HSTA-05: create UUID mount point and assign its verified mounted root to the engine account
allow olivares_helper_storage_t olivares_backups_t:dir { add_name create getattr open read search setattr write };

# HSTA-06: reach the fixed backups parent under /mnt
allow olivares_helper_storage_t mnt_t:dir { getattr search };

# HSTA-07: PID1 creates and removes the native unit RuntimeDirectory
allow init_t olivares_storage_grow_run_t:dir { add_name create getattr mounton open read remove_name rmdir search setattr write };

# HSTA-08: prepare existing-partition definitions only in its native unit runtime directory
allow olivares_helper_storage_t olivares_storage_grow_run_t:dir { add_name getattr open read search write };

# HSTA-09: write closed native definitions; never raw disk contents
allow olivares_helper_storage_t olivares_storage_grow_run_t:file { create getattr open read setattr write };

# HSTA-10: native repart reads definitions; PID1 removes them when the unit stops
allow init_t olivares_storage_grow_run_t:file { getattr open read unlink };

# HSTA-11: existing DR executor manages its selected backup directory
allow olivares_t olivares_backups_t:dir { add_name create getattr ioctl lock open read remove_name rename rmdir search setattr write };

# HSTA-12: existing DR executor writes encrypted bundles and reads them for verification or restore
allow olivares_t olivares_backups_t:file { append create getattr ioctl lock map open read rename setattr unlink write };

# HSTA-13: fixed mounted root filesystem information ioctl and statfs; no root files are read
allow olivares_helper_storage_t root_t:dir { getattr ioctl open read search };

# HSTA-14: native UDisks mounts the fixed UUID backup directory
allow devicekit_disk_t olivares_backups_t:dir { getattr mounton open read search };

# HSTA-15: native UDisks uses the dedicated backup mount context
allow devicekit_disk_t olivares_backups_t:filesystem { getattr mount relabelto unmount };

# HSTA-16: install and mount the persistent UUID backup target at boot
allow init_t olivares_backups_t:dir { create getattr mounton search setattr };

# HSTA-17: native fstab mount with the dedicated context at boot
allow init_t olivares_backups_t:filesystem { getattr mount relabelto unmount };

# HSTA-18: measure whether the native SELinux filesystem is mounted
allow olivares_helper_storage_t security_t:dir { getattr search };

# HSTA-19: measure existence of the native SELinux enforce node; no policy changes
allow olivares_helper_storage_t security_t:file getattr;

# HSTA-20: measure the fixed mounted btrfs root with statfs
allow olivares_helper_storage_t fs_t:filesystem getattr;

# HSTA-21: verify the mounted ext4 backup filesystem before ownership transfer
allow olivares_helper_storage_t olivares_backups_t:filesystem getattr;

# HSTA-22: existing DR verifies the pinned target filesystem and reports its capacity
allow olivares_t olivares_backups_t:filesystem getattr;

# HSTA-23: read only the neutral recipe declaration for automatic growth
allow olivares_helper_storage_t olivares_image_etc_t:file { getattr open read };

# HSTA-24: detect image defaults from the neutral profile declaration
allow olivares_t olivares_image_etc_t:file { getattr open read };

# HSTA-25: reach the exact neutral marker without reading private firstboot files
allow olivares_helper_storage_t olivares_appliance_etc_t:dir { getattr search };

# HSTA-26: reach the exact neutral marker without reading private firstboot files
allow olivares_t olivares_appliance_etc_t:dir { getattr search };

# HSTA-27: systemd Subscribe requires read-only manager status to observe the fixed growth job; measured method_subscribe denial on the enforcing image
allow olivares_helper_storage_t init_t:system status;

# TOOL-09: the confine helper's exec from olivares_t (system_r) computes system_u:system_r:olivares_tool_t; application_domain authorizes no role, and without this one every exec into the tool domain is an invalid context, refused under enforcing
role system_r types olivares_tool_t;

# GPUB-04: the engine's exec computes system_u:system_r:olivares_gitpub_t
role system_r types olivares_gitpub_t;

# GIMP-04: the engine's exec computes system_u:system_r:olivares_git_import_t
role system_r types olivares_git_import_t;

# TOOL-75: the tool's exec computes system_u:system_r:olivares_cmd_t; domain_type authorizes no role
role system_r types olivares_cmd_t;

# HOOK-06: the exec from olivares_cmd_t (system_r) computes system_u:system_r:olivares_hook_t, as TOOL-09 for the tool
role system_r types olivares_hook_t;

# CHOOK-10: the exec computes system_u:system_r:olivares_container_hook_t, as TOOL-09 for the tool
role system_r types olivares_container_hook_t;

# RELAY-13: the exec computes system_u:system_r:olivares_container_relay_t, as TOOL-09 for the tool
role system_r types olivares_container_relay_t;

########################################
#
# The one base-policy interface call
#

# CLI-16: the operator's SSH login, root through sudo, runs olivares-appliance in olivares_cli_t: the one base-policy interface call, inside optional_policy; its rules are checked on the installed policy
optional_policy(`
	unconfined_run_to(olivares_cli_t, olivares_cli_exec_t)
')
