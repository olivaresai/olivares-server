# ---- TOOL ----

# TOOL-02: the engine creates its tools directory with the tool label; versions and staged files inherit it
type_transition olivares_t olivares_var_lib_t:dir olivares_tool_exec_t "tools";

# TOOL-03: stages a version, renames it into place, removes a failed staging
allow olivares_t olivares_tool_exec_t:dir { add_name create getattr open read remove_name rename reparent rmdir search setattr write };

# TOOL-04: writes the verified download, its lock and receipt; executes a program only through the transition (TOOL-05), never execute_no_trans
allow olivares_t olivares_tool_exec_t:file { create execute getattr lock open read rename setattr unlink write };

# TOOL-05: the confine helper's exec of an installed tool (core/runtime/confine/landlock_linux.go) enters the confined tool domain
type_transition olivares_t olivares_tool_exec_t:process olivares_tool_t;

# TOOL-06: the engine's helper may enter the tool domain, only through the tool's own program
allow olivares_t olivares_tool_t:process transition;

# TOOL-07: a tool probe or session child gets its own process group, so a timeout or stop ends the whole tool
allow olivares_t self:process setpgid;

# TOOL-08: the engine re-executes its own binary as the confine helper and the session guard, in its own domain; the helper's exec of a tool then enters olivares_tool_t (TOOL-05)
allow olivares_t olivares_exec_t:file execute_no_trans;

# TOOL-10: the engine unit sets NoNewPrivileges and the helper sets no_new_privs, so its exec of an installed tool may enter the tool domain only with this permission
allow olivares_t olivares_tool_t:process2 nnp_transition;

# TOOL-11: the tool inherits the helper's lowered core and file-size limits (rlimitinh) and its signal state, and starts without AT_SECURE: entering the tool domain lowers privilege, it is no setuid boundary
allow olivares_t olivares_tool_t:process { noatsecure rlimitinh siginh };

# TOOL-12: the confine helper drops its capabilities, lowers the child's core and file-size limits and raises its nice value before it executes the tool
allow olivares_t self:process { setcap setrlimit setsched };

# TOOL-13: a directory the engine creates in /tmp (its egress proxy's, signature check's, DR restore's or inspection's scratch) gets the engine's scratch type, which no rule lets an installed tool reach
type_transition olivares_t tmp_t:dir olivares_engine_tmp_t;

# TOOL-14: the engine creates its own scratch directories in /tmp (os.MkdirTemp; the unit keeps PrivateTmp=false) and removes them when it is done (os.RemoveAll)
allow olivares_t tmp_t:dir { add_name read remove_name search write };

# TOOL-65: the engine makes, fills and removes its own scratch directories in /tmp
allow olivares_t olivares_engine_tmp_t:dir { add_name create getattr open read remove_name rmdir search setattr write };

# TOOL-66: the engine writes, locks and removes files in its own scratch directories, including the DR backup's VACUUM INTO snapshot
allow olivares_t olivares_engine_tmp_t:file { create getattr lock open read rename unlink write };

# TOOL-15: the engine makes, fills and removes a confined child's TMPDIR under <data>/tool-tmp
allow olivares_t olivares_tmp_t:dir { add_name create getattr open read remove_name rmdir search setattr write };

# TOOL-16: the engine writes and removes files in a confined child's TMPDIR (the network helper's proxy trust file)
allow olivares_t olivares_tmp_t:file { create getattr open read rename unlink write };

# TOOL-17: the engine creates the provider accounts' homes under the data directory with the tool home label
type_transition olivares_t olivares_var_lib_t:dir olivares_tool_home_t "accounts";

# TOOL-18: a version's probe scratch folder (home, config, tmp) gets the tool home label, so a probe never writes the tools' programs
type_transition olivares_t olivares_tool_exec_t:dir olivares_tool_home_t ".probe";

# TOOL-19: the engine creates, fills and removes the accounts' homes and the probes' scratch folders
allow olivares_t olivares_tool_home_t:dir { add_name create getattr open read remove_name rename reparent rmdir search setattr write };

# TOOL-20: the engine writes an account's tool login files and reads them back
allow olivares_t olivares_tool_home_t:file { append create getattr link lock map open read rename setattr unlink write };

# TOOL-21: the engine creates the folders of sessions without a registered workspace with the workspace label
type_transition olivares_t olivares_var_lib_t:dir olivares_workspace_t "session-workspaces";

# TOOL-22: the engine creates the git worktrees of sessions launched with one with the workspace label
type_transition olivares_t olivares_var_lib_t:dir olivares_workspace_t "session-worktrees";

# TOOL-55: the engine creates the documented root of registered workspaces (the install's workspace_dir) with the workspace label
type_transition olivares_t olivares_var_lib_t:dir olivares_workspace_t "workspaces";

# TOOL-64: the engine creates the root of the confined children's TMPDIRs under the data directory with the tools' temporary label; each child's s-* directory inherits it
type_transition olivares_t olivares_var_lib_t:dir olivares_tmp_t "tool-tmp";

# TOOL-58: the session egress proxy binds its unix socket in its temporary directory (/tmp/eg-*/proxy.sock); it removes the socket when the session ends
allow olivares_t olivares_engine_tmp_t:sock_file { create setattr unlink write };

# TOOL-59: the session's network helper connects to the egress proxy's socket
allow olivares_t self:unix_stream_socket connectto;

# TOOL-60: the session's network boundary clones a user and network namespace for the tool
allow olivares_t self:user_namespace create;

# TOOL-61: inside that namespace the helper brings loopback up with its namespace-local capabilities and drops them before the tool runs
allow olivares_t self:cap_userns { net_admin setpcap sys_admin };

# TOOL-62: the helper's interface ioctl that brings loopback up
allow olivares_t self:udp_socket ioctl;

# TOOL-63: the network helper connects to the egress proxy's loopback listener
allow olivares_t ephemeral_port_t:tcp_socket name_connect;

# TOOL-91: the session's network helper listens on a loopback provider's own port (a local model runtime's labeled port: 11434, 1234, 8000, 8080, or one the admin labels with semanage port) inside the session's namespace, so the session can start; TOOL-109 permits the direct loopback client connection on that port; SELinux cannot tell that namespace from the host's, so the rule also admits the engine's managed-Ollama probe, which binds and closes 127.0.0.1:11434 in the host's namespace (one service per address; the child's own bind is TOOL-115); a loopback provider on a port without that label still gets no rule, and the session's error names the semanage port command
allow olivares_t olivares_model_runtime_port_t:tcp_socket name_bind;

# TOOL-115: the managed Ollama child, and any other tool-domain process without a session network namespace, binds a labeled local-model port (11434, 1234, 8000, 8080 or one the admin labels); no other port type or domain gains name_bind
allow olivares_tool_t olivares_model_runtime_port_t:tcp_socket name_bind;

# TOOL-23: the engine creates, prepares and removes session folders and worktrees
allow olivares_t olivares_workspace_t:dir { add_name create getattr open read remove_name rename reparent rmdir search setattr write };

# TOOL-24: the engine and its git write the files of session folders and worktrees
allow olivares_t olivares_workspace_t:file { append create getattr link lock map open read rename setattr unlink write };

# TOOL-25: the helper resolves the protected /etc/olivares (filepath.EvalSymlinks) before it carves it out of /etc
allow olivares_t olivares_etc_t:dir getattr;

# TOOL-26: the carve of /etc resolves the link /etc/rc.local to /etc/rc.d/rc.local to decide whether to grant it
allow olivares_t initrc_exec_t:file getattr;

# TOOL-27: the helper resolves /dev/random, one of the devices it grants every tool
allow olivares_t random_device_t:chr_file getattr;

# TOOL-28: a tool reads and writes the pipes the engine hands it as stdin, stdout and stderr
allow olivares_tool_t olivares_t:fifo_file { getattr ioctl read write };

# TOOL-29: a session tool reads and writes the stream socket the engine hands it for the session's protocol
allow olivares_tool_t olivares_t:unix_stream_socket { read write };

# TOOL-30: the AI tools run JIT runtimes (Bun, V8): the unit allows executable memory for the same reason (MemoryDenyWriteExecute=false)
allow olivares_tool_t self:process execmem;

# TOOL-31: a tool's HTTP client and its own local server (OpenCode serves its client on loopback)
allow olivares_tool_t self:tcp_socket { accept bind connect create getattr getopt listen read setopt write };

# TOOL-32: a tool resolves names (DNS over UDP)
allow olivares_tool_t self:udp_socket { connect create getattr read setopt write };

# TOOL-33: a tool's runtime lists the host's interfaces and addresses before it binds or connects
allow olivares_tool_t self:netlink_route_socket { bind create getattr nlmsg_read read write };

# TOOL-34: a tool reaches its provider over HTTPS (443); which hosts it may reach is the session's network boundary, not this type
allow olivares_tool_t http_port_t:tcp_socket name_connect;

# TOOL-35: a session tool reaches the engine's session proxy, which listens on a loopback port the kernel picks
allow olivares_tool_t ephemeral_port_t:tcp_socket name_connect;

# TOOL-36: OpenCode binds its local server (4096) and its client connects to it
allow olivares_tool_t unreserved_port_t:tcp_socket { name_bind name_connect };

# TOOL-37: a tool's local server binds a loopback address
allow olivares_tool_t node_t:tcp_socket node_bind;

# TOOL-38: a tool's TLS client finds the system trust store (/etc/pki, /etc/ssl)
allow olivares_tool_t cert_t:dir { getattr open read search };

# TOOL-39: a tool's TLS client reads the system CA bundle
allow olivares_tool_t cert_t:file { getattr open read };

# TOOL-40: a tool's TLS client follows /etc/ssl/cert.pem to the CA bundle
allow olivares_tool_t cert_t:lnk_file read;

# TOOL-41: a tool's resolver reads /etc/resolv.conf
allow olivares_tool_t net_conf_t:file { getattr open read };

# TOOL-42: a tool's runtime reads /proc/version at start
allow olivares_tool_t proc_t:file { open read };

# TOOL-43: a tool's runtime reads /proc/sys/vm/mmap_min_addr at start
allow olivares_tool_t sysctl_vm_t:file { getattr open read };

# TOOL-44: a tool's runtime reaches /proc/sys/fs
allow olivares_tool_t sysctl_fs_t:dir search;

# TOOL-45: a tool's runtime reads its cgroup's cpu.max and controllers to size its thread pool
allow olivares_tool_t cgroup_t:file { getattr open read };

# TOOL-46: a tool's runtime reaches /proc/sys/fs/binfmt_misc at start
allow olivares_tool_t binfmt_misc_fs_t:dir search;

# TOOL-47: a tool passes through the data directory to its account home and its session folder and resolves those paths name by name (lstat); it lists nothing there
allow olivares_tool_t olivares_var_lib_t:dir { getattr search };

# TOOL-48: a tool passes through the tools directory to its own program and its probe scratch folder
allow olivares_tool_t olivares_tool_exec_t:dir search;

# TOOL-49: a tool keeps its configuration, cache and state in its account home or probe scratch folder
allow olivares_tool_t olivares_tool_home_t:dir { add_name create getattr open read remove_name rename rmdir search setattr write };

# TOOL-50: a tool writes its configuration, database, logs and lock files in its account home
allow olivares_tool_t olivares_tool_home_t:file { append create getattr lock map open read rename setattr unlink write };

# TOOL-118: Claude Code copies its configuration backup by reflink (FICLONE) before it falls back to a plain copy; TOOL-50 holds every other access to these files
allow olivares_tool_t olivares_tool_home_t:file ioctl;

# TOOL-51: a session tool works in its session folder and watches it for changes
allow olivares_tool_t olivares_workspace_t:dir { add_name create getattr open read remove_name rename rmdir search setattr watch write };

# TOOL-52: a session tool reads and writes the files of its session folder
allow olivares_tool_t olivares_workspace_t:file { append create getattr lock map open read rename setattr unlink write };

# TOOL-53: a tool uses its TMPDIR, a temporary directory the engine made for it
allow olivares_tool_t olivares_tmp_t:dir { add_name create getattr open read remove_name rmdir search write };

# TOOL-54: Bun extracts its native addon into TMPDIR and maps it executable (dlopen); append measured on candidate rc16 (a background task's output file)
allow olivares_tool_t olivares_tmp_t:file { append create execute getattr map open read rename unlink write };

# TOOL-76: the folder the engine installs OpenCode's ripgrep in gets its own type at creation; its version folders and the rg in them inherit it, so no other installed program, whatever its name, can be run in place
type_transition olivares_t olivares_tool_exec_t:dir olivares_tool_rg_exec_t ".ripgrep";

# TOOL-77: the engine writes the pinned ripgrep, makes it executable, and rereads it to hash it on a later install
allow olivares_t olivares_tool_rg_exec_t:file { create getattr open read setattr unlink write };

# TOOL-78: OpenCode runs that ripgrep in its own domain for glob and grep
allow olivares_tool_t olivares_tool_rg_exec_t:file { execute execute_no_trans getattr map open read };

# TOOL-111: Claude Code alone re-executes its installed program in the same confined domain; entrypoint covers native and relay entry
allow olivares_tool_t olivares_tool_claude_exec_t:file { entrypoint execute execute_no_trans getattr map open read };

# TOOL-112: the native confine helper enters the tool domain through Claude Code's dedicated executable type
type_transition olivares_t olivares_tool_claude_exec_t:process olivares_tool_t;

# TOOL-113: the engine stages, verifies, renames and executes Claude Code's installed program
allow olivares_t olivares_tool_claude_exec_t:file { create execute getattr lock open read rename setattr unlink write };

# TOOL-114: the installer creates claude.part with Claude's type; renaming it to claude preserves that type
type_transition olivares_t olivares_tool_exec_t:file olivares_tool_claude_exec_t "claude.part";

# TOOL-87: the engine makes the ripgrep folder, stages a version in it and renames the staging folder into place
allow olivares_t olivares_tool_rg_exec_t:dir { add_name create getattr open read remove_name rename reparent rmdir search setattr write };

# TOOL-88: OpenCode finds the ripgrep on its PATH, through these folders
allow olivares_tool_t olivares_tool_rg_exec_t:dir { getattr search };

# TOOL-67: an installed tool runs a shell for its Bash tool; the exec enters the command domain (TOOL-68)
allow olivares_tool_t shell_exec_t:file execute;

# TOOL-68: a shell an installed tool executes runs in the command domain, not in the tool's
type_transition olivares_tool_t shell_exec_t:process olivares_cmd_t;

# TOOL-69: an installed tool runs a generic program (git, ls); the exec enters the command domain (TOOL-70)
allow olivares_tool_t bin_t:file execute;

# TOOL-70: a generic program an installed tool executes runs in the command domain
type_transition olivares_tool_t bin_t:process olivares_cmd_t;

# TOOL-71: the tool's exec of a shell or generic program enters the command domain
allow olivares_tool_t olivares_cmd_t:process transition;

# TOOL-72: the tool runs with no_new_privs (Landlock), so its exec into the command domain is an NNP transition
allow olivares_tool_t olivares_cmd_t:process2 nnp_transition;

# TOOL-90: without it the exec runs in secure-execution mode and glibc drops TMPDIR (and TMP) from the command's environment; rlimitinh and siginh stay denied, so limits never rise and signal state is reset
allow olivares_tool_t olivares_cmd_t:process noatsecure;

# ---- RUN ----

# RUN-01: the engine's per-run folders (PEP settings, npmrc, git read credential, MCP configuration) get their own type
type_transition olivares_t olivares_var_lib_t:dir olivares_run_t "run";

# RUN-02: the engine makes a folder per run and removes it
allow olivares_t olivares_run_t:dir { add_name create getattr open read remove_name rename rmdir search setattr write };

# RUN-03: the engine writes a run's files (temporary name, then rename) and removes them
allow olivares_t olivares_run_t:file { create getattr open read rename setattr unlink write };

# RUN-04: the tool reaches its run's folder; Landlock grants it that run's folder alone
allow olivares_tool_t olivares_run_t:dir { getattr open read search };

# RUN-05: Claude Code reads its PEP settings, and a tool its run's npmrc, git read credential and MCP configuration
allow olivares_tool_t olivares_run_t:file { getattr open read };

# RUN-06: the programs a tool runs reach its run's folder: git's credential helper (cat through sh) and npm; Landlock grants a command that run's folder alone
allow olivares_cmd_t olivares_run_t:dir { getattr search };

# RUN-07: and read its git read credential and its npmrc; writing stays refused (N-CMD-RUN-WRITE)
allow olivares_cmd_t olivares_run_t:file { getattr open read };

# ---- TOOL ----

# TOOL-93: Claude Code watches its configuration folder for changes (inotify)
allow olivares_tool_t olivares_tool_home_t:dir watch;

# TOOL-94: Claude Code probes inotify on a file in its TMPDIR before it watches
allow olivares_tool_t olivares_tmp_t:file watch;

# ---- EGIT ----

# EGIT-01: the engine finds git (exec.LookPath's faccessat X_OK is checked as execute) and runs it for session Git and worktree sessions; the exec enters the command domain (EGIT-02)
allow olivares_t bin_t:file { execute getattr open read };

# EGIT-02: a generic program the engine executes (git) runs in the command domain, never in the engine's (the regression)
type_transition olivares_t bin_t:process olivares_cmd_t;

# EGIT-03: the engine's exec of git enters the command domain
allow olivares_t olivares_cmd_t:process transition;

# EGIT-04: the engine unit sets NoNewPrivileges, so its exec into the command domain is an NNP transition
allow olivares_t olivares_cmd_t:process2 nnp_transition;

# EGIT-05: git writes its output and errors to the pipes the engine reads (exec.Cmd)
allow olivares_cmd_t olivares_t:fifo_file { getattr ioctl read write };

# ---- GNET ----

# GNET-01: the engine names the domain of its network git's next exec (core/runtime/confine.StartInDomain); the generator pins the domains it may enter
allow olivares_t self:process setexec;

# ---- GPUB ----

# GPUB-01: gitpublish's git enters its own domain
allow olivares_t olivares_gitpub_t:process transition;

# GPUB-02: the engine unit sets NoNewPrivileges, so that exec is an NNP transition
allow olivares_t olivares_gitpub_t:process2 nnp_transition;

# GPUB-03: git is the domain's entry point and runs its helpers in place
allow olivares_gitpub_t bin_t:file { entrypoint execute execute_no_trans getattr map open read };

# GPUB-05: git writes its output to the pipes the engine reads
allow olivares_gitpub_t olivares_t:fifo_file { getattr ioctl read write };

# GPUB-06: the engine's gitpublish folder (repositories, the empty home, ssh key files) gets its own type
type_transition olivares_t olivares_var_lib_t:dir olivares_gitpublish_t "gitpublish";

# GPUB-07: the engine makes the gitpublish folders and clears key files a stopped push left
allow olivares_t olivares_gitpublish_t:dir { add_name create getattr open read remove_name rename rmdir search setattr write };

# GPUB-08: the engine writes a push's ssh key file for its one run and removes it
allow olivares_t olivares_gitpublish_t:file { create getattr open read setattr unlink write };

# GPUB-09: git manages the publication repositories
allow olivares_gitpub_t olivares_gitpublish_t:dir { add_name create getattr open read remove_name rename rmdir search setattr write };

# GPUB-10: git writes objects, refs and config there, and ssh reads the push's key file and known_hosts
allow olivares_gitpub_t olivares_gitpublish_t:file { append create getattr link lock map open read rename setattr unlink write };

# GPUB-11: git reaches its folders under /var/lib/olivares
allow olivares_gitpub_t olivares_var_lib_t:dir { getattr search };

# GPUB-12: git feeds a session's commits into the engine's repository (alternates to the session's objects): read only
allow olivares_gitpub_t olivares_workspace_t:dir { getattr open read search };

# GPUB-13: and reads those objects: never writes them
allow olivares_gitpub_t olivares_workspace_t:file { getattr map open read };

# GPUB-14: a session repository's links are read, never followed out by a write
allow olivares_gitpub_t olivares_workspace_t:lnk_file { getattr read };

# GPUB-15: git connects to the publication remote
allow olivares_gitpub_t self:tcp_socket { connect create getattr getopt read setopt write };

# GPUB-16: a push over https
allow olivares_gitpub_t http_port_t:tcp_socket name_connect;

# GPUB-17: a push over ssh
allow olivares_gitpub_t ssh_port_t:tcp_socket name_connect;

# GPUB-18: git runs GIT_SSH_COMMAND through sh -c; every value in it is engine-built and quoted (connectors/gitpublish/git.go sshEnv); no entry point
allow olivares_gitpub_t shell_exec_t:file { execute execute_no_trans getattr map open read };

# GPUB-19: the shell runs ssh in place for a push over ssh; no entry point
allow olivares_gitpub_t ssh_exec_t:file { execute execute_no_trans getattr map open read };

# ---- GIMP ----

# GIMP-01: the skills import's git enters its own domain
allow olivares_t olivares_git_import_t:process transition;

# GIMP-02: the engine unit sets NoNewPrivileges, so that exec is an NNP transition
allow olivares_t olivares_git_import_t:process2 nnp_transition;

# GIMP-03: prlimit is the domain's entry point and runs git in place
allow olivares_git_import_t bin_t:file { entrypoint execute execute_no_trans getattr map open read };

# GIMP-05: git writes its output to the pipes the engine reads
allow olivares_git_import_t olivares_t:fifo_file { getattr ioctl read write };

# GIMP-06: the skills import's staging folder gets its own type
type_transition olivares_t olivares_var_lib_t:dir olivares_skills_import_t "imports";

# GIMP-07: the engine makes a staging folder per import and removes it
allow olivares_t olivares_skills_import_t:dir { add_name create getattr open read remove_name rename rmdir search setattr write };

# GIMP-08: the engine reads the imported pack and removes the staging
allow olivares_t olivares_skills_import_t:file { getattr open read unlink };

# GIMP-09: git builds the bare staging repository
allow olivares_git_import_t olivares_skills_import_t:dir { add_name create getattr open read remove_name rename rmdir search setattr write };

# GIMP-10: git writes the fetched objects
