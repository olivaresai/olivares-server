# ---- LOCAL ----

# LOCAL-01: PID 1 creates /run/olivares-portal-api with its file-context label when tmpfiles has not, then binds local.sock in it; RemoveOnStop= on authority.sock and the unlink of a stale socket before a bind remove it from the directory
allow init_t olivares_portal_api_run_t:dir { add_name create getattr remove_name search setattr write };

# LOCAL-02: PID 1 binds local.sock with its file-context label, sets root and 0666, touches it after listen (socket_address_listen) and unlinks a stale socket before binding
allow init_t olivares_portal_api_sock_t:sock_file { create getattr setattr unlink write };

# LOCAL-03: PID 1 creates the listener in the service's exec domain (socket.c:1480-1500), sets SO_PASSCRED, binds and listens; the portal inherits it as the descriptor named local
allow init_t olivares_portal_t:unix_stream_socket { bind create getattr listen setopt };

# LOCAL-04: RuntimeDirectory: created with its label and owned by the portal, bound writable under ProtectSystem=strict, removed on stop; no producer writes receipts yet, so the portal gets no row here
allow init_t olivares_portal_receipts_run_t:dir { create getattr mounton open read rmdir search setattr };

# LOCAL-05: StateDirectory creates only the operations leaf inside the root-owned parent
allow init_t olivares_portal_var_lib_t:dir { add_name getattr search write };

# LOCAL-06: StateDirectory: creates the leaf 0700 with its label, gives the tree to the static account when its owner differs, and binds it writable
allow init_t olivares_portal_ops_t:dir { create getattr mounton open read search setattr };

# LOCAL-07: the ownership fix of an existing leaf's files for the static account (DynamicUser=no)
allow init_t olivares_portal_ops_t:file { getattr setattr };

# LOCAL-08: systemd-tmpfiles (systemd.fc) creates the lifecycle directory with its label, root:olivares-lifecycle 0750, and the lock in it
allow systemd_tmpfiles_t olivares_lifecycle_run_t:dir { add_name create getattr search setattr write };

# LOCAL-09: 'f' creates a missing lock (root:olivares-lifecycle 0640) and never truncates or replaces an existing inode
allow systemd_tmpfiles_t olivares_lifecycle_lock_t:file { create getattr open setattr write };

# LOCAL-10: creates the socket directory root:root 0755 with its label
allow systemd_tmpfiles_t olivares_portal_api_run_t:dir { create getattr search setattr };

# LOCAL-11: creates the leaf's parent root:root 0755 with its label; never under /var/lib/private
allow systemd_tmpfiles_t olivares_portal_var_lib_t:dir { create getattr search setattr };

