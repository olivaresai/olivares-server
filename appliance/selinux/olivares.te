# TOOL-83: a command writes files in its TMPDIR and runs what it builds there, in its own domain; append measured on candidate rc16 (a background task's output file)
allow olivares_cmd_t olivares_tmp_t:file { append create execute execute_no_trans getattr ioctl map open read rename setattr unlink write };

# TOOL-84: a command's standard input and output are the tool's socket pair
