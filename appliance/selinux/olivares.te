# TOOL-85: the shell reads /etc/passwd to name its user
allow olivares_cmd_t passwd_file_t:file { getattr open read };

# TOOL-86: git init probes symlink support with a link it creates and removes in the new repository
allow olivares_cmd_t olivares_workspace_t:lnk_file { create getattr unlink };

# TOOL-89: the engine removes a session's folder (os.RemoveAll) even when a command left a symbolic link in it; it never reads the link
allow olivares_t olivares_workspace_t:lnk_file { getattr unlink };

# ---- GORT ----

# GORT-37: the Go runtime of a Go tool (the local Ollama) reads the process's cgroup limits at start
allow olivares_tool_t cgroup_t:dir search;

# GORT-38: the Go runtime of a Go tool (the local Ollama) reads the transparent huge page size at start
