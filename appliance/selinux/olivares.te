type_transition olivares_firstboot_t olivares_portal_etc_t:file olivares_portal_key_t "tls.key.new";

# FBOOT-103: console-certificate creates the staged key O_NOFOLLOW 0600 (reusing a leftover with O_TRUNC), renames it into place, lstats it and reads it to certify it again; no unlink, setattr or append, and no other domain gains the key
allow olivares_firstboot_t olivares_portal_key_t:file { create getattr open read rename write };

# FBOOT-104: secure.LocalLANAddresses lists the host's interfaces and addresses over rtnetlink (net.Interfaces), as the engine does for its own leaf; the unit's RestrictAddressFamilies=AF_NETLINK allows only that family; no route or link change
allow olivares_firstboot_t self:netlink_route_socket { bind create getattr nlmsg_read read write };

# ---- PORTAL ----

# PORTAL-52: systemd creates the fixed unit credential directory, writes entries, sets its read-only service ACL and removes failed or stopped-unit copies
allow init_t olivares_portal_cred_t:dir { add_name create getattr open read remove_name rmdir search setattr write };

# PORTAL-53: write_credential opens each of the three private copies O_RDWR, chmods it, applies the read-only service ACL and renames it from its temporary name into place; failed or stopped-unit copies are unlinked; no private source-key or engine-file write
allow init_t olivares_portal_cred_t:file { create getattr open read rename setattr unlink write };

# PORTAL-54: olivares-portal-sockets.path watches /run/olivares-firewall/measured.json (PathChanged); an inotify watch checks read on the file without opening it; no write
allow init_t olivares_firewall_run_t:file read;

# ---- SSH ----

# SSH-01: keeps authenticated SSH forwarding to the product HTTPS port working after its dedicated port label is installed
allow sshd_session_t olivares_console_port_t:tcp_socket name_connect;

# SSH-02: authenticated SSH forwarding reaches the loopback portal; application sign-in and all other port permissions remain separate
allow sshd_session_t olivares_portal_port_t:tcp_socket name_connect;

# SSH-03: sshd reads the host public keys the module types for first boot (C36); the private keys keep the base policy's sshd_key_t
allow sshd_t olivares_ssh_host_pub_t:file { getattr open read };

