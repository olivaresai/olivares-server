# EGIT-06: gitpublish resolves the ssh client (exec.LookPath: stat, then faccessat X_OK, which SELinux checks as execute) before an ssh push; the engine never runs it: git runs it in olivares_gitpub_t (measured on candidates rc16-rc18: getattr refused, every ssh push answered lookup_incomplete)
allow olivares_t ssh_exec_t:file { execute getattr };

# ---- TOOL ----

# TOOL-97: Claude Code's Bash tool runs hostname when it prepares its shell; it runs in place, in the command domain (measured on candidate rc16)
allow olivares_cmd_t hostname_exec_t:file { execute execute_no_trans map open read };

# TOOL-98: Claude Code watches the processes its Bash tool started: it reaches /proc/<pid> (measured on candidate rc16)
allow olivares_tool_t olivares_cmd_t:dir search;

# TOOL-99: and reads /proc/<pid>/stat, their state; SELinux cannot narrow this to stat, so the tool may read any /proc/<pid> file of its commands (cmdline, environ, status): they hold nothing the tool did not give them (their environment is the tool's), and ptrace stays refused
allow olivares_tool_t olivares_cmd_t:file { open read };

# TOOL-100: Claude Code resolves a link in its session's folder before it reads the file (getattr refused on candidate rc17, enforcing); read is the readlink; commands already hold their own (TOOL-86)
allow olivares_tool_t olivares_workspace_t:lnk_file { getattr read };

# TOOL-95: a session stop sends SIGTERM to the tool's process group so the tool can save its transcript, then SIGKILL (procrunner_unix.go); the session guard and a probe's timeout kill what is left; SIGTERM was refused 7 times on candidate rc16
allow olivares_t olivares_tool_t:process { sigkill signal };

# TOOL-96: the commands a tool started share its process group and live below the guard, so the same stop reaches them
allow olivares_t olivares_cmd_t:process { sigkill signal };

# TOOL-105: the session guard lists what lives below it, so a stop ends the commands a tool left running in the background: it reaches /proc/<pid> of its own children (the engine process is the guard, olivares_t)
allow olivares_t olivares_tool_t:dir search;

# TOOL-106: and reads /proc/<pid>/stat of each, its state, to tell a live process from a zombie; SELinux cannot narrow this to stat, so the engine may read the /proc/<pid> files of its tool's processes that the kernel does not gate with a ptrace check (stat, status, cmdline): it started them, and environ and maps stay refused because these rows grant no ptrace; the guard walks only its own children, which the kernel lists in its own /proc entry, never the processes of other domains
allow olivares_t olivares_tool_t:file { getattr open read };

# TOOL-116: before it registers the managed Ollama's endpoint, the engine lists /proc/<pid>/fd of the Ollama it started (TOOL-105 reaches it): every tool-domain process may bind the model runtime ports, so an answer on 127.0.0.1:11434 alone does not show that the started child serves it
allow olivares_t olivares_tool_t:dir { getattr open read };

# TOOL-117: and reads those descriptor links (socket:[inode]) to find the child's listening socket; the kernel gates them with a ptrace read check, which SELinux answers with TOOL-106's file read; no ptrace permission is granted
allow olivares_t olivares_tool_t:lnk_file read;

# TOOL-107: the same pass for the commands the tool started, which become the guard children once their parent is killed
allow olivares_t olivares_cmd_t:dir search;

# TOOL-108: and their state, the same read
allow olivares_t olivares_cmd_t:file { getattr open read };

# TOOL-109: SELinux checks only the port type: a tool in a session network namespace connects to its local-model endpoint; the namespace is the address boundary, not the port type
allow olivares_tool_t olivares_model_runtime_port_t:tcp_socket name_connect;

# TOOL-110: Git can tell absent config from unreadable credentials: directory search returns ENOENT, while every file read stays refused
allow olivares_cmd_t olivares_tool_home_t:dir search;

