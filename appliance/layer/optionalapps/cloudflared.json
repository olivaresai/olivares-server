{
  "name": "olivares-cloudflared",
  "x-olivares": {
    "title": "Cloudflare Tunnel",
    "version": "2026.2.0",
    "enabled_by_default": false
  },
  "services": {
    "app": {
      "image": "docker.io/cloudflare/cloudflared@sha256:404528c1cd63c3eb882c257ae524919e4376115e6fe57befca8d603656a91a4c",
      "container_name": "olivares-cloudflared",
      "restart": "unless-stopped",
      "user": "0:0",
      "network_mode": "host",
      "command": [
        "tunnel",
        "--no-autoupdate",
        "--metrics",
        "127.0.0.1:20241",
        "run",
        "--token-file",
        "/run/secrets/tunnel-token"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "./tunnel-token",
          "target": "/run/secrets/tunnel-token",
          "read_only": true,
          "bind": {
            "selinux": "z"
          }
        },
        {
          "type": "bind",
          "source": "./origin-ca.pem",
          "target": "/run/certs/origin-ca.pem",
          "read_only": true,
          "bind": {
            "selinux": "z"
          }
        }
      ],
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ]
    }
  }
}
