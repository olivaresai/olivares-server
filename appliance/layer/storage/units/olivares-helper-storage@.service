#
# One connection to the storage helper, started by olivares-helper-storage.socket with the
# connection as standard input and output. The helper takes no argument and no path; it reads
# the storage inventory from UDisks2 over the system bus (GetManagedObjects, EnableModule of the
# LVM2 module and the manager's Can methods) and from the kernel (the boot id, a loop device's
# LOOP_GET_STATUS64, the first MiB of a disk without a serial and sysfs holders), and changes no
# disk on an inventory read. Confirmed actions call UDisks2 or the one native
# root-growth unit. The helper opens block nodes read-only and cannot write them.
# CHOWN/FOWNER apply only to the verified mounted backup root; no SYS_ADMIN or
# raw block-write capability is granted.
[Unit]
Description=Appliance storage helper (one connection)
Documentation=https://github.com/olivaresai/olivares

[Service]
ExecStart=/usr/libexec/olivares/olivares-portal-storage
User=root
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=180
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER
AmbientCapabilities=
UMask=0077

# Only the UUID-derived backup mount directory is writable. Formatting and
# fstab belong to UDisks2; root growth belongs to the native maintenance unit.
ReadWritePaths=/mnt/olivares-backups
