# The disposable AlmaLinux 10 system of the appliance base fixture, the rpm counterpart of the
# Debian 13 one in ../Containerfile: systemd as PID 1, cloud-init as the host-settings owner
# reading a NoCloud seed, OpenSSH for the host keys cloud-init generates, and the product and
# olivares-appliance-base installed from their built rpms in one rpm run, with every other
# dependency of the base package installed first, the way the image recipe installs them:
# offline, starting nothing. dnf installs the system and rpm installs the packages; nothing here
# runs a Debian tool. The build context is the same staging directory as ../Containerfile's,
# with olivares.rpm and olivares-appliance-base.rpm in place of the debs. A container is component evidence; it does not qualify an image, a hypervisor or
# firmware, and it runs under the host's SELinux policy, not AlmaLinux's, so it measures nothing
# about the appliance's SELinux labels or policy: the image run does.
# almalinux:10 as Docker Hub listed it, pinned by its index digest.
FROM almalinux:10@sha256:838c2fafefb1a8a0d7f8cdbc3b0551c2a2b1eb0cd87aad6d62aecadb18311f1b
# Replace the minimal image's conflicting provider with the package the fixture installs.
RUN dnf -y swap coreutils-single coreutils \
 && dnf -y --setopt=install_weak_deps=False install systemd dbus-broker cloud-init openssh-server \
    shadow-utils util-linux NetworkManager polkit udisks2 udisks2-lvm2 lvm2 podman iproute gawk coreutils sed grep \
 && dnf clean all
# A template carries no instance identity: no SSH host key and an empty machine ID.
RUN rm -f /etc/ssh/ssh_host_* && : > /etc/machine-id
COPY cloud-init.conf /etc/cloud/cloud.cfg.d/99-appliance-fixture.cfg
COPY olivares.rpm olivares-appliance-base.rpm /tmp/
RUN rpm -i /tmp/olivares.rpm /tmp/olivares-appliance-base.rpm && rm /tmp/olivares.rpm /tmp/olivares-appliance-base.rpm
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
