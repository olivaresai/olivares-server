[Unit]
Description=Appliance native account verification socket
After=systemd-sysusers.service

[Socket]
ListenStream=/run/olivares-helpers/pam.sock
Accept=yes
SocketUser=root
SocketGroup=olivares-appliance
SocketMode=0660
DirectoryMode=0755
PassCredentials=yes
MaxConnections=4
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
