#
# Socket of the Appliance Console, the appliance's status and licence activation on port 9443.
#
# Enabled at sockets.target by the package's postinstall and by the image's preset, so a
# booted appliance has the console on 127.0.0.1:9443 and nowhere else. Enabling it opens
# nothing to the network and serves nothing without verified TLS custody. Remote access
# needs a selected management interface, verified TLS custody and a measured firewall
# prerequisite, and is then a separate socket unit per management interface: its own
# ListenStream= on that interface's address, BindToDevice= naming the interface and
# Service=olivares-portal.service (olivares-portal-sockets writes it). It is never a drop-in on
# this unit: BindToDevice= applies to every listener of a socket unit, so it would bind
# 127.0.0.1:9443 to the uplink too, and IPAddressAllow=localhost below would still drop remote
# peers. It sets no IP allow list: the firewall's measured row says who may connect. No
# listener is ever a wildcard address. The console reads each socket's binding back and
# refuses any non-loopback socket not bound to a selected interface.
[Unit]
Description=Appliance Console socket (loopback only)
Documentation=https://github.com/olivaresai/olivares

[Socket]
ListenStream=127.0.0.1:9443
# Beside the loopback address, the kernel drops traffic from any other peer.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=sockets.target
