#
# The public product package repository, rendered from the product's packaging/repositories/dnf-repo.template.
# Both signature checks are set on their own (DNF 4: gpgcheck for the packages, repo_gpgcheck for the metadata; it has no
# pkg_gpgcheck, which that template names for DNF 5), and the trust anchor is the preinstalled key, pinned by fingerprint in
# the recipe (package-repository-key.json), never a repository URL. It is shipped DISABLED: the appliance's packages
# come from the entitled channel, whose repository file olivares-entitled-repo writes at run time, with its credential,
# once a licence is installed; the image ships neither the file nor a credential. The public address answers 404 today,
# and an enabled repository that answers 404 fails every `dnf upgrade`.
[olivares]
name=Olivares Server stable
baseurl=https://packages.olivares.ai/stable/rpm/x86_64
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-olivares-package-repository
metadata_expire=0
type=rpm-md
